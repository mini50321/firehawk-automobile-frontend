# Read by scripts/set-env.mjs during `npm run build` (the "prebuild" npm hook)
# and baked into src/environments/environment.ts before Angular compiles it.
# This file itself is never loaded automatically — it's a template. Set the real
# value in your deployment platform's environment variables UI (e.g. Vercel:
# Project Settings > Environment Variables) or export it locally before building.
#
# If unset, the build keeps whatever apiBaseUrl is already committed in
# environment.ts, so local `npm run build` works unchanged without this file.
API_BASE_URL=https://your-backend.onrender.com/api
